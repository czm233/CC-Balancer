#!/usr/bin/env bash
# ============================================================
# CC-Balancer 配置文件
# 用途：定义 Claude Code Token 周期管理的各项参数
# 使用方式：source scripts/config.env
# ============================================================

# --- 通知设置 ---
# 进入禁区前提前多少分钟发出警告
ALERT_MINUTES_BEFORE=30

# --- 时间边界常量（24 小时制，整点） ---
# 白天安全期起点（含）
SAFE_DAY_START=6    # 06:00

# 白天安全期终点（含）
SAFE_DAY_END=20     # 20:59

# 夜间可用期起点（含）
SAFE_NIGHT_START=21 # 21:00

# 夜间可用期终点（含，跨午夜）
SAFE_NIGHT_END=1    # 01:59

# 禁区起点（含）
BLOCK_START=2       # 02:00

# 禁区终点（不含）
BLOCK_END=6         # 05:59（到 06:00 解除）

# --- 周期参数 ---
# Claude Code 单次使用触发的周期时长（小时）
CYCLE_DURATION_HOURS=5

# --- 进程检测 ---
# 用于检测活跃周期的进程名
CLAUDE_PROCESS_NAME="claude"
